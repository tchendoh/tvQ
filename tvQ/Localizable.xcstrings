    "Prefer show's original language" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefer show's original language"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préférer la langue d'origine de la série"
          }
        }
      }
    },
    "When on, a show's page and episodes use its original language instead of the setting above. Search results are unaffected." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, a show's page and episodes use its original language instead of the setting above. Search results are unaffected."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois activé, la fiche et les épisodes d'une série utilisent sa langue d'origine plutôt que le réglage ci-dessus. Les résultats de recherche ne sont pas affectés."
          }
        }
      }
    },
