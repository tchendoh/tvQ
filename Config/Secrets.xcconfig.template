// Copiez ce fichier en "Secrets.xcconfig" (sans .template) et remplissez votre clé.
// Secrets.xcconfig est dans .gitignore — ne sera jamais commité.
TMDB_API_KEY = votre_cle_tmdb_ici

// Jeton de débogage App Check : générez-le avec `uuidgen`, puis enregistrez-le dans
// la console Firebase > App Check > tvQ > Gérer les jetons de débogage.
APP_CHECK_DEBUG_TOKEN = votre_jeton_ici
