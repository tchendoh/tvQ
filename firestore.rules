rules_version = '2';

// Règles de sécurité de tvQ (projet-tvq).
// Déployer avec : firebase deploy --only firestore:rules
// Tester avec : cd firestore-tests && npm install && npm test
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userID) {
      return signedIn() && request.auth.uid == userID;
    }

    // Clé de cache : "{idTMDB}_{langue}", ex. "1399_fr-CA" ou "1399_original".
    function validCacheKey(key) {
      return key.matches('^[0-9]{1,10}_[A-Za-z0-9-]{1,20}$');
    }

    // Un document de cache : exactement {payload, syncedAt}, syncedAt pas dans le futur.
    function validCacheEntry(payloadField) {
      let data = request.resource.data;
      return data.keys().hasOnly([payloadField, 'syncedAt'])
          && data.keys().hasAll([payloadField, 'syncedAt'])
          && data.syncedAt is timestamp
          && data.syncedAt <= request.time + duration.value(5, 'm');
    }

    // ---- Données personnelles ----
    // users/{userID} = { followedShows: { "<idTMDB>": <date d'ajout>, ... },
    //                   mutedShows: { "<idTMDB>": true, ... } }
    // Un seul document par utilisateur : une lecture pour toute la liste.
    function validUserDoc() {
      let data = request.resource.data;
      return data.keys().hasOnly(['followedShows', 'mutedShows'])
          && (!('followedShows' in data) || (data.followedShows is map
                                            && data.followedShows.size() <= 2000))
          && (!('mutedShows' in data) || (data.mutedShows is map
                                         && data.mutedShows.size() <= 2000));
    }

    match /users/{userID} {
      allow read, delete: if isOwner(userID);
      allow create, update: if isOwner(userID) && validUserDoc();
    }

    // ---- Caches partagés (contenu TMDB, aucune donnée personnelle) ----
    // Lecture et écriture par tout utilisateur connecté, forme validée, jamais de suppression.
    // Risque résiduel accepté : un utilisateur malveillant peut écrire un contenu faux
    // mais bien formé. Solution définitive : écriture par Cloud Function seulement.
    match /showsCache/{cacheKey} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && validCacheKey(cacheKey)
                            && validCacheEntry('episodes')
                            && request.resource.data.episodes is list
                            && request.resource.data.episodes.size() <= 2000;
    }

    match /showMetadataCache/{cacheKey} {
      allow read: if signedIn();
      allow create, update: if signedIn()
                            && validCacheKey(cacheKey)
                            && validCacheEntry('show')
                            && request.resource.data.show is map;
    }

    // ---- Tendances (calculées hors de l'app) ----
    // Écrites seulement par le script du Mac mini (SDK Admin, qui ne passe pas par
    // ces règles) à partir des séries suivies : comptes anonymes et agrégés.
    match /trends/{document} {
      allow read: if signedIn();
      // aucune écriture : seul le Mac mini (SDK Admin) écrit ici
    }

    // ---- Tout le reste : refusé ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
